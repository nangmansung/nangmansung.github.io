{%- comment -%}
  Research page list shared by _pages/research.md (English) and _pages/ko/research.md (Korean).
  Items come from site.data.research_pages (_plugins/uploaded_html.rb), filtered by language.
{%- endcomment -%}
{%- assign cur_lang = page.lang | default: site.lang -%}
{% assign items = site.data.research_pages | where_exp: 'i', 'i.list_langs contains cur_lang' %}
{% if items and items.size > 0 %}

<div class="research-list">
  {% for item in items %}
    <a class="research-card" href="{{ item.url | relative_url }}">
      <h3>{{ item.title }}{% include lang_badge.liquid post=item %}</h3>
      {% if item.description %}<p>{{ item.description }}</p>{% endif %}
      {% if item.date != "" %}<span class="research-date">{{ item.date }}</span>{% endif %}
    </a>
  {% endfor %}
</div>

{% else %}
{% if cur_lang == 'ko' %}아직 올라온 연구 페이지가 없어요.{% else %}No research pages yet.{% endif %}
{% endif %}
