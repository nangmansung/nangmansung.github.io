{%- comment -%}
  Recent Research pages for the about page, in the page's language (see _plugins/i18n.rb).
  Items come from site.data.research_pages (_plugins/uploaded_html.rb), newest first.
{%- endcomment -%}
{%- assign cur_lang = page.lang | default: site.lang -%}
{%- assign items = site.data.research_pages | where_exp: 'i', 'i.list_langs contains cur_lang' -%}
<div class="news">
  {% if items.size > 0 %}
    <div class="table-responsive">
      <table class="table table-sm table-borderless">
        {% for item in items limit: page.latest_research.limit %}
          <tr>
            <th scope="row" style="width: 20%">
              {%- if item.date != "" -%}
                {%- if cur_lang == 'ko' -%}{{ item.date | date: '%Y. %-m. %-d.' }}{%- else -%}{{ item.date | date: '%b %d, %Y' }}{%- endif -%}
              {%- endif -%}
            </th>
            <td>
              <a class="news-title" href="{{ item.url | relative_url }}">{{ item.title }}</a>{% include lang_badge.liquid post=item %}
            </td>
          </tr>
        {% endfor %}
      </table>
    </div>
  {% else %}
    <p>{% if cur_lang == 'ko' %}아직 올라온 연구가 없어요.{% else %}No research pages yet.{% endif %}</p>
  {% endif %}
</div>
